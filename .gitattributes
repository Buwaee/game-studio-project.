# Normalize detected text files; keep binary assets unchanged.
* text=auto

# Source code, configuration, and serialized text assets.
*.cs text eol=lf
*.json text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.asmdef text eol=lf
*.asmref text eol=lf
*.shader text eol=lf
*.shadergraph text eol=lf
*.shadersubgraph text eol=lf
*.hlsl text eol=lf
*.cginc text eol=lf
*.compute text eol=lf
*.meta text eol=lf
*.unity text eol=lf
*.prefab text eol=lf
*.mat text eol=lf
*.anim text eol=lf
*.controller text eol=lf
*.overrideController text eol=lf
# Some .asset files (for example terrain data) can be binary.
*.asset text=auto
ProjectSettings/*.asset text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf

# Imported binary assets must not have line endings changed.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.tga binary
*.psd binary
*.exr binary
*.hdr binary
*.fbx binary
*.blend binary
*.wav binary
*.mp3 binary
*.ogg binary
*.mp4 binary
*.mov binary
*.ttf binary
*.otf binary
*.dll binary
*.unitypackage binary
*.zip binary
